{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ES2022",
            "DOM"
        ],
        "jsx": "react-jsx",
        "jsxImportSource": "@n3rdw1z4rd/smoke-ui",
        "isolatedModules": true,
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": [
        "src"
    ]
}